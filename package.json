{
  "name": "nexus",
  "version": "0.0.1",
  "private": true,
  "description": "NEXUS — Personal Intelligence & Execution System. Monorepo root.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test packages",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p apps/dashboard",
    "health": "bun run packages/core/src/bin/health.ts",
    "dashboard:dev": "bun run --filter '@nexus/dashboard' dev",
    "dashboard:build": "bun run --filter '@nexus/dashboard' build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2"
  }
}
