# NEXUS environment template.
#
# Copy to `.env` and fill in only what you actually use:
#     cp .env.example .env
#
# `.env` and every `.env.*` variant except this file are git-ignored. Never put
# a real credential in this file -- it IS committed.
#
# Nothing here is required to run the foundation. With no keys set, NEXUS starts
# correctly and reports its model layer as unavailable rather than failing at a
# random point later. Verify with: bun run health

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | test | production
NEXUS_ENV=development
# debug | info | warn | error
NEXUS_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
# Setting a key marks that provider "configured". It does NOT make it usable:
# no provider adapters are implemented yet, by design. These variable names are
# fixed now so that adding an adapter later is a purely additive change.
#
# A provider with no key is skipped by the model router rather than called and
# failed.

# NEXUS_ANTHROPIC_API_KEY=
# NEXUS_ANTHROPIC_BASE_URL=

# NEXUS_OPENAI_API_KEY=
# NEXUS_OPENAI_BASE_URL=

# NEXUS_GOOGLE_API_KEY=
# NEXUS_GOOGLE_BASE_URL=

# NEXUS_OPENROUTER_API_KEY=
# NEXUS_OPENROUTER_BASE_URL=

# NEXUS_XAI_API_KEY=
# NEXUS_XAI_BASE_URL=

# ---------------------------------------------------------------------------
# Free-tier providers (ADR 0011)
# ---------------------------------------------------------------------------
# All of these speak the OpenAI-compatible shape, so one adapter serves them
# all. Base URLs have sensible defaults; set one only to override.
#
# Rough free allowances as of Aug 2026 -- verify against the vendor, they change:
#   groq       ~30 req/min, fastest generation
#   cerebras   ~1M tokens/day, best for background work
#   openrouter ~20 req/min across a set of free models
#   mistral    free mode, no card
#   sambanova  per-model daily token allowance

# NEXUS_GROQ_API_KEY=
# NEXUS_GROQ_BASE_URL=

# NEXUS_CEREBRAS_API_KEY=
# NEXUS_CEREBRAS_BASE_URL=

# NEXUS_MISTRAL_API_KEY=
# NEXUS_MISTRAL_BASE_URL=

# NEXUS_SAMBANOVA_API_KEY=
# NEXUS_SAMBANOVA_BASE_URL=

# A local runtime (Ollama, vLLM) needs no credential -- point the base URL at it:
# NEXUS_OPENAI_BASE_URL=http://localhost:11434/v1
